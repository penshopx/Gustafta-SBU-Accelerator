modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-typecheck-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "frontend-typecheck-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "preparation-summary-print-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "document-cleanup-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-codegen-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "clerk-session-compatibility"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-operational-budget-regression"

[[workflows.workflow]]
name = "api-typecheck-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test:typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "frontend-typecheck-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/gustafta-sbu run test:typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "preparation-summary-print-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test:print"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "document-cleanup-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --test test/document-cleanup.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-codegen-regression"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-spec run test:codegen"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "clerk-session-compatibility"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --test test/sbu-assessment-clerk.test.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ai-operational-budget-regression"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server exec node --test test/ai-budget-postgres.test.mjs && pnpm --filter @workspace/gustafta-sbu exec node --import tsx --test src/lib/ai-budget-error.test.ts"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild", "clamav", "util-linux", "firefox", "geckodriver"]

[userenv]

[userenv.development]
AI_BUDGET_CLAUDE_PRICING_JSON = "{\"model\":\"claude-sonnet-5-5\",\"validUntil\":\"2027-01-01T00:00:00.000Z\",\"maxInputTokens\":1000000,\"inputMicrosPerMillion\":2000000,\"outputMicrosPerMillion\":10000000}"

[userenv.shared]
DOCUMENT_SIGNATURE_ALERT_PROVIDER = "slack"
DOCUMENT_SIGNATURE_SLACK_CHANNEL = "C0CBXQF9D0E"
DOCUMENT_SIGNATURE_SLACK_CONNECTION_ID = "conn_slack_01M5TP72X7D3J47H61ZYFMNZD9"
